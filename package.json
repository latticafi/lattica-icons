{
  "name": "@latticafi/icons",
  "version": "0.1.0",
  "description": "React icon library exported from Figma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latticafi/lattica-icons.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./Icon": {
      "import": {
        "types": "./dist/Icon.d.ts",
        "default": "./dist/Icon.js"
      },
      "require": {
        "types": "./dist/Icon.d.cts",
        "default": "./dist/Icon.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "export:figma": "node --env-file-if-exists=.env.local scripts/export-figma-icons.mjs",
    "optimize": "node scripts/optimize-svgs.mjs",
    "build:svg": "node scripts/generate-components.mjs",
    "build:bundle": "tsup",
    "build": "npm run optimize && npm run build:svg && npm run build:bundle",
    "generate": "npm run export:figma && npm run build",
    "clean": "rm -rf dist src/icons src/index.ts src/icon-names.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "svgo": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
