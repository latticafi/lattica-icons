{
  "name": "@latticafi/icons",
  "version": "0.4.0",
  "description": "React icon library exported from Figma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latticafi/lattica-icons.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./Icon": {
      "import": {
        "types": "./dist/Icon.d.ts",
        "default": "./dist/Icon.js"
      },
      "require": {
        "types": "./dist/Icon.d.cts",
        "default": "./dist/Icon.cjs"
      }
    },
    "./catalog": {
      "import": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      },
      "require": {
        "types": "./dist/catalog.d.cts",
        "default": "./dist/catalog.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "export:figma": "node --env-file-if-exists=.env.local scripts/export-figma-icons.mjs",
    "export:figma:full": "npm run export:figma -- --full",
    "optimize": "node scripts/optimize-svgs.mjs",
    "build:svg": "node scripts/generate-components.mjs",
    "build:bundle": "tsup --silent",
    "build": "npm run optimize && npm run build:svg && npm run build:bundle",
    "generate": "npm run export:figma && npm run build",
    "clean": "rm -rf dist src/icons src/index.ts src/icon-names.ts src/icon-loaders.ts src/catalog.ts",
    "test": "node --test tests/*.test.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm test && npm run verify:sources && npm run build && npm run verify:package",
    "prepublishOnly": "npm run verify",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgo": "^4.1.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
